# ========================================================
# KLIKNOTULEN - CONTOH PENGATURAN LINGKUNGAN (.env.example)
# ========================================================

# Kunci API Google Gemini (Dapatkan gratis di https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Pilihan Model AI Default: gemini-1.5-flash / gemini-2.0-flash / gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# Informasi Aplikasi
APP_NAME=KlikNotulen
APP_ENV=production
